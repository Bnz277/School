`timescale 1ns/1ps

module tb_compare;

    // 定义信号
    reg a;
    reg b;
    wire equal;

    // 实例化被测模块
    compare uut (
        .equal(equal),
        .a(a),
        .b(b)
    );

    // 测试过程
    initial begin
        $monitor("At time %t: a=%b, b=%b, equal=%b", $time, a, b, equal);

        // 测试用例 1: a == b
        a = 0; b = 0;
        #10;

        // 测试用例 2: a != b
        a = 0; b = 1;
        #10;

        // 测试用例 3: a != b
        a = 1; b = 0;
        #10;

        // 测试用例 4: a == b
        a = 1; b = 1;
        #10;

        // 结束仿真
        $finish;
    end

endmodule