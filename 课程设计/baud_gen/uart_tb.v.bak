module uart_tb;

    // 定义测试信号
    reg clk;
    reg rst_n;
    reg rx;
    reg [7:0] tx_data;
    reg tx_en;
    wire tx;
    wire tx_done;
    wire [7:0] rx_data;
    wire rx_valid;

    // 时钟生成（50MHz）
    initial begin
        clk = 1'b0;
        forever #10 clk = ~clk;  // 20ns周期（50MHz）
    end

    // 复位信号
    initial begin
        rst_n = 1'b0;
        #100 rst_n = 1'b1;
    end

    // 实例化被测模块
    uart_top uut(
        .clk(clk),
        .rst_n(rst_n),
        .rx(rx),
        .tx(tx),
        .tx_data(tx_data),
        .tx_en(tx_en),
        .tx_done(tx_done),
        .rx_data(rx_data),
        .rx_valid(rx_valid)
    );

    // 测试激励
    initial begin
        // 测试发送功能：发送数据0x55（二进制01010101）
        #200;
        tx_data = 8'h55;
        tx_en = 1'b1;
        #20;
        tx_en = 1'b0;
        
        // 等待发送完成
        wait(tx_done);
        #100;
        
        // 测试接收功能：模拟串口输入（0xAA的UART帧）
        // UART帧格式：起始位(0) + 数据位(10101010, LSB优先) + 偶校验(0) + 停止位(1)
        rx = 1'b1;  // 空闲状态
        #1000;
        
        // 发送起始位
        rx = 1'b0;
        #1300;  // 1位时间（约8.68μs@115200bps，此处用1300*20ns=26μs模拟，实际需根据波特率调整）
        
        // 发送数据位（LSB优先：0->1->0->1->0->1->0->1）
        rx = 1'b0; #1300;
        rx = 1'b1; #1300;
        rx = 1'b0; #1300;
        rx = 1'b1; #1300;
        rx = 1'b0; #1300;
        rx = 1'b1; #1300;
        rx = 1'b0; #1300;
        rx = 1'b1; #1300;
        
        // 发送偶校验位（10101010的偶校验为0）
        rx = 1'b0; #1300;
        
        // 发送停止位
        rx = 1'b1; #1300;
        
        // 等待接收完成
        wait(rx_valid);
        $display("接收数据: 0x%h", rx_data);
        
        #100;
        $finish;
    end

endmodule