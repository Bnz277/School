module uart_rx(
    input wire clk,       // 系统时钟
    input wire rst_n,     // 复位信号
    input wire baud_clk,  // 波特率时钟
    input wire rx,        // 接收引脚
    output reg [7:0] rx_data,  // 接收数据
    output reg rx_valid  // 接收有效标志
);

    // 状态机状态定义
    localparam IDLE = 3'd0,
               START_DET = 3'd1,
               DATA_RX = 3'd2,
               PARITY_CHK = 3'd3,
               STOP_CHK = 3'd4;

    reg [2:0] state, next_state;
    reg [3:0] bit_cnt;       // 位计数器（0~8）
    reg [3:0] sample_cnt;    // 采样计数器（0~15），16倍过采样
    reg [7:0] rx_data_reg;   // 接收数据寄存器
    reg rx_reg;              // 接收信号缓存
    reg parity_bit;          // 接收的奇偶校验位
    reg stop_bit;            // 接收的停止位
    reg rx_ready;            // 接收准备标志

    // 采样计数器与接收信号缓存
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            sample_cnt <= 4'd0;
            rx_reg <= 1'b1;
        end else begin
            rx_reg <= rx;  // 缓存接收信号，消除亚稳态
            if (state == START_DET || state == DATA_RX || state == PARITY_CHK || state == STOP_CHK) begin
                if (sample_cnt == 4'd15) begin
                    sample_cnt <= 4'd0;
                end else begin
                    sample_cnt <= sample_cnt + 1'b1;
                end
            end else begin
                sample_cnt <= 4'd0;
            end
        end
    end

    // 状态机时序逻辑
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state <= IDLE;
            bit_cnt <= 4'd0;
            rx_data <= 8'd0;
            rx_valid <= 1'b0;
            rx_data_reg <= 8'd0;
            parity_bit <= 1'b0;
            stop_bit <= 1'b0;
            rx_ready <= 1'b1;
        end else begin
            state <= next_state;
            case (state)
                IDLE: begin
                    rx_valid <= 1'b0;
                    if (!rx_reg && rx_ready) begin  // 检测到起始位（下降沿）
                        rx_ready <= 1'b0;
                        bit_cnt <= 4'd0;
                        next_state <= START_DET;
                    end else begin
                        next_state <= IDLE;
                    end
                end
                START_DET: begin
                    if (sample_cnt == 4'd7) begin  // 在第8个时钟周期采样（中间点）
                        if (!rx_reg) begin  // 确认起始位
                            next_state <= DATA_RX;
                        end else begin
                            rx_ready <= 1'b1;
                            next_state <= IDLE;
                        end
                    end else begin
                        next_state <= START_DET;
                    end
                end
                DATA_RX: begin
                    if (sample_cnt == 4'd7) begin  // 中间点采样
                        rx_data_reg[bit_cnt] <= rx_reg;  // 保存数据位（LSB优先）
                        if (bit_cnt < 4'd7) begin
                            bit_cnt <= bit_cnt + 1'b1;
                            next_state <= DATA_RX;
                        end else begin
                            bit_cnt <= bit_cnt + 1'b1;
                            next_state <= PARITY_CHK;
                        end
                    end else begin
                        next_state <= DATA_RX;
                    end
                end
                PARITY_CHK: begin
                    if (sample_cnt == 4'd7) begin
                        parity_bit <= rx_reg;  // 采样奇偶校验位
                        bit_cnt <= bit_cnt + 1'b1;
                        next_state <= STOP_CHK;
                    end else begin
                        next_state <= PARITY_CHK;
                    end
                end
                STOP_CHK: begin
                    if (sample_cnt == 4'd7) begin
                        stop_bit <= rx_reg;  // 采样停止位
                        // 校验停止位（应为1）
                        if (stop_bit && (parity_bit == ^rx_data_reg)) begin
                            rx_data <= rx_data_reg;
                            rx_valid <= 1'b1;
                        end
                        rx_ready <= 1'b1;
                        next_state <= IDLE;
                    end else begin
                        next_state <= STOP_CHK;
                    end
                end
                default: next_state <= IDLE;
            endcase
        end
    end

endmodule